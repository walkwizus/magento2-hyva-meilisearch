<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <remove src="https://cdn.jsdelivr.net/npm/nouislider@15.7.0/dist/nouislider.min.css"/>
    </head>
    <body>
        <referenceBlock name="meilisearch.frontend.search">
            <block class="Magento\Catalog\Block\Product\ProductList\Toolbar" name="meilisearch.toolbar" template="Hyva_WalkwizusMeilisearch::toolbar.phtml"/>
            <block name="meilisearch.frontend.search.js.hit-render" template="Hyva_WalkwizusMeilisearch::product/js/hit-render.phtml"/>
            <block name="meilisearch.frontend.search.product.price.alpine" template="Hyva_WalkwizusMeilisearch::product/price/alpine.phtml">
                <block name="meilisearch.frontend.search.product.price.alpine.amount" as="amount" template="Hyva_WalkwizusMeilisearch::product/price/alpine/amount.phtml"/>
            </block>
            <block name="meilisearch.frontend.search.product.list.actions" template="Hyva_WalkwizusMeilisearch::product/list/actions.phtml"/>
            <block name="meilisearch.frontend.search.product.swatches.alpine" template="Hyva_WalkwizusMeilisearch::product/list/swatches/alpine.phtml">
                <block name="meilisearch.frontend.search.product.swatches.alpine.tooltip" as="tooltip" template="Magento_Swatches::product/tooltip.phtml"/>
            </block>
            <block name="meilisearch.frontend.search.product.list.actions.alpine" template="Hyva_WalkwizusMeilisearch::product/list/actions/alpine.phtml"/>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block name="meilisearch.frontend.search.product.list.js.wishlist" template="Magento_Catalog::product/list/js/wishlist.phtml"/>
            <block name="meilisearch.frontend.search.product.list.js.compare" template="Magento_Catalog::product/list/js/compare.phtml"/>
            <block name="meilisearch.frontend.search.product.list.js.swatch-options" template="Magento_Swatches::product/js/swatch-options.phtml" ifconfig="catalog/frontend/show_swatches_in_product_list"/>
        </referenceContainer>
        <referenceBlock name="meilisearch.frontend.layers">
            <block name="meilisearch.frontend.layers.active" template="Hyva_WalkwizusMeilisearch::layers/active.phtml"/>
            <block name="meilisearch.frontend.layers.type.swatch" template="Hyva_WalkwizusMeilisearch::layers/type/swatch.phtml"/>
            <block name="meilisearch.frontend.layers.type.checkbox" template="Hyva_WalkwizusMeilisearch::layers/type/checkbox.phtml"/>
            <block name="meilisearch.frontend.layers.type.slider" template="Hyva_WalkwizusMeilisearch::layers/type/slider.phtml"/>
            <block name="meilisearch.frontend.layers.js.layers" template="Hyva_WalkwizusMeilisearch::layers/js/layers.phtml"/>
            <block name="meilisearch.frontend.layers.js.slider" template="Hyva_WalkwizusMeilisearch::layers/js/slider.phtml"/>
        </referenceBlock>
    </body>
</page>
