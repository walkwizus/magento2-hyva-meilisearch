<?php

declare(strict_types=1);

use Magento\Framework\View\Element\Template;
use Magento\Framework\Escaper;

/**
 * @var Template $block
 * @var Escaper $escaper
 */
$alias = (string)$block->getData('alias');
?>
<div class="flex flex-col gap-2" x-data="initAutocompleteCategory">
    <div class="flex justify-end px-2">
        <span
            class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-[11px] font-medium text-gray-700"
            x-text="resultCountLabel()"
        ></span>
    </div>

    <div class="grid grid-cols-2 gap-2">
        <template
            x-for="hit in store.autocomplete.results['<?= $escaper->escapeJs($alias) ?>']"
            :key="hit.entity_id"
        >
            <a
                data-autocomplete-item
                class="flex flex-col gap-1 p-2 rounded-lg border border-gray-100 hover:border-gray-200 hover:bg-gray-50 focus:bg-gray-50 focus:outline-none cursor-pointer"
                :href="getCategoryUrl()"
                @click="store.closeAutocomplete"
                @keydown.enter.prevent="clickSelf"
            >
                <div class="text-sm font-medium text-gray-900 line-clamp-1" x-text="hit.name"></div>
                <div class="text-xs text-gray-500 line-clamp-1" x-text="hit.path"></div>

                <div class="mt-1">
                    <span
                        class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-700"
                        x-text="productCountLabel()"
                    ></span>
                </div>
            </a>
        </template>
    </div>
</div>

<script>
    (function () {
        var alias = '<?= $escaper->escapeJs($alias) ?>';
        var labelResults = '<?= $escaper->escapeJs(__('results')) ?>';
        var labelProducts = '<?= $escaper->escapeJs(__('products')) ?>';

        function initAutocompleteCategory() {
            return {
                get store() {
                    return Alpine.store('meilisearch');
                },

                resultCountLabel() {
                    const results = this.store.autocomplete.results[alias];
                    const count = results ? results.length : 0;
                    return count + ' ' + labelResults;
                },

                getCategoryUrl() {
                    return '/' + (this.hit.url_key || '');
                },

                productCountLabel() {
                    return (this.hit.product_count || 0) + ' ' + labelProducts;
                },

                clickSelf() {
                    this.$event.target.click();
                }
            }
        }
        window.addEventListener('alpine:init', () => Alpine.data('initAutocompleteCategory', initAutocompleteCategory), {once: true})
    })();
</script>
<?php
/** @var \Hyva\Theme\Model\ViewModelRegistry $viewModels */
/** @var \Hyva\Theme\ViewModel\HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(\Hyva\Theme\ViewModel\HyvaCsp::class);
$hyvaCsp->registerInlineScript();
?>
