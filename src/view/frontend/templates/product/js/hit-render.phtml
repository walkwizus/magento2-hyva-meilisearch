<?php

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\WalkwizusMeilisearch\ViewModel\ProductActions;
use Hyva\WalkwizusMeilisearch\ViewModel\ProductSwatches;
use Magento\Framework\View\Element\Template;

/**
 * @var Template $block
 * @var ViewModelRegistry $viewModels
 */
$productActions = $viewModels->require(ProductActions::class);
$productActionsConfig = [
    'addToCartUrl' => $productActions->getAddToCartUrlTemplate(),
    'productIdPlaceholder' => ProductActions::PRODUCT_ID_PLACEHOLDER,
    'configureOnProductPageTypes' => $productActions->getConfigureOnProductPageTypes(),
];
$swatchConfig = $viewModels->require(ProductSwatches::class)->getConfig();
$jsonFlags = JSON_UNESCAPED_SLASHES | JSON_HEX_TAG;
?>
<script>
    const meilisearchProductActionsConfig = <?= /* @noEscape */ json_encode($productActionsConfig, $jsonFlags) ?>;
    const meilisearchSwatchConfig = <?= /* @noEscape */ json_encode($swatchConfig, $jsonFlags) ?>;

    function meilisearchHitRender(hit) {
        const store = () => Alpine.store('meilisearch');
        const render = () => store().meilisearchProductRender;
        const priceAttributeCode = () => store().meilisearchConfig.priceAttributeCode;
        let priceViewCache;

        const swatchTooltip = typeof initSwatchOptions === 'function' ? initSwatchOptions() : {};

        return Object.assign(swatchTooltip, {
            selection: {},
            swatchAttributes: null,

            attributes() {
                if (!render() || !store().meilisearchConfig.showSwatchesInProductList) {
                    return [];
                }

                if (this.swatchAttributes === null) {
                    this.swatchAttributes = render().getSwatchAttributes(hit, store().meilisearchConfig.swatchOptions);
                }

                return this.swatchAttributes;
            },

            imageUrl() {
                const imageType = store().getListImageConfig().type || 'small_image';
                const path = render() ? render().getSelectedImage(hit, this.selection, imageType) : '';

                return path ? store().getProductImage(path) : store().getHitImageUrl(hit);
            },

            priceView() {
                if (!render()) {
                    return null;
                }

                const key = JSON.stringify(this.selection);

                if (priceViewCache === undefined || priceViewCache.key !== key) {
                    const view = render().getPriceView(
                        hit,
                        priceAttributeCode(),
                        render().getSelectedPrice(hit, this.selection, priceAttributeCode(), store().meilisearchConfig.currencyCode),
                        store().meilisearchConfig,
                        (amount) => hyva.formatPrice(amount)
                    );

                    priceViewCache = {
                        key: key,
                        value: view ? Object.assign(view, { productUrl: store().getProductUrl(hit.url_key) }) : null
                    };
                }

                return priceViewCache.value;
            },

            fallbackPrice() {
                const value = hit[priceAttributeCode()];

                const config = store().meilisearchConfig;

                return value !== undefined && value !== null && config.currencyCode === config.baseCurrencyCode
                    ? hyva.formatPrice(value)
                    : '';
            },

            isSelected(attribute, option) {
                return Number(this.selection[attribute.attribute_id]) === Number(option.value);
            },

            isAvailable(attribute, option) {
                return render().isOptionAvailable(hit, this.selection, attribute.attribute_id, option.value);
            },

            select(attribute, option) {
                if (!this.isAvailable(attribute, option)) {
                    return;
                }

                this.selection = render().toggleOption(this.selection, attribute.attribute_id, option.value);
            },

            swatchKind(option) {
                return render().getSwatchKind(option);
            },

            swatchText(option) {
                return render().getSwatchText(option);
            },

            isSaleable() {
                return !!(hit.stock && hit.stock.is_in_stock);
            },

            mustBeConfiguredOnProductPage() {
                return meilisearchProductActionsConfig.configureOnProductPageTypes.includes(hit.type_id);
            },

            addToCartUrl() {
                return meilisearchProductActionsConfig.addToCartUrl
                    .replace(meilisearchProductActionsConfig.productIdPlaceholder, hit.id);
            },

            formKey() {
                return hyva.getFormKey();
            },

            formId() {
                return 'product_addtocart_form_' + hit.id;
            },

            swatchConfig() {
                return meilisearchSwatchConfig;
            },

            swatchInputId(attribute, option) {
                return 'attribute-option' + hit.id + '-' + attribute.attribute_id + '-' + option.value;
            },

            isVisualSwatch(option) {
                return this.swatchKind(option) !== 'text';
            },

            swatchImageUrl(option) {
                const base = String(store().meilisearchConfig.mediaUrl || '').replace(/\/+$/, '');
                const path = String(option.swatch_image || '').replace(/^\/+/, '');

                return path ? base + '/' + path : '';
            },

            swatchColorStyle(option) {
                return {
                    width: meilisearchSwatchConfig.imageWidth + 'px',
                    height: meilisearchSwatchConfig.imageHeight + 'px',
                    backgroundColor: option.swatch_value
                };
            },

            swatchTooltip(option) {
                if (!meilisearchSwatchConfig.showTooltip || !this.isVisualSwatch(option)) {
                    return null;
                }

                const kind = this.swatchKind(option);

                return JSON.stringify({
                    preview: kind === 'image' ? this.swatchImageUrl(option) : option.swatch_value,
                    label: option.label,
                    type: kind,
                    width: meilisearchSwatchConfig.thumbWidth,
                    height: meilisearchSwatchConfig.thumbHeight
                });
            },

            showSwatchTooltip(event, option) {
                if (this.swatchTooltip(option) && typeof this.showTooltip === 'function') {
                    this.showTooltip(event);
                }
            },

            hideSwatchTooltip() {
                if (typeof this.hideTooltip === 'function') {
                    this.hideTooltip();
                }
            }
        });
    }
</script>
